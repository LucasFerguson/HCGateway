# Same MongoDB instance/credentials the Flask API and Python workers use -
# see ../api/.env. Never commit the real value.
MONGO_URI=mongodb://root:CHANGE_ME@db:27017/hcgateway?authSource=admin

# HTTP port this service listens on. Compose maps it to the host; keep it
# distinct from the Flask API's 6644.
GRAPHQL_PORT=6645

# development enables the introspection landing page; production disables it.
NODE_ENV=production
GRAPHQL_PLAYGROUND_ENABLED=false

# Safety backstops - all optional, shown here at their defaults.
# GRAPHQL_RESOLVER_TIMEOUT_MS=25000
# GRAPHQL_RESPONSE_SIZE_CAP_BYTES=104857600
# GRAPHQL_MAX_QUERY_DEPTH=12
# GRAPHQL_MAX_ALIAS_COUNT=30
# GRAPHQL_MAX_QUERY_COMPLEXITY=2000
