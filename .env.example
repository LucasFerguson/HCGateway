# Used by Docker Compose to initialize the local MongoDB instance.
# Use the same username/password in api/.env's MONGO_URI.
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-strong-local-password

# FluidCalendar sleep export. Docker Compose injects these values only into
# calendar-worker; do not put the API key in api/.env.
FLUIDCALENDAR_BASE_URL=https://your-fluidcalendar-host
FLUIDCALENDAR_API_KEY=fc_replace-with-a-write-scoped-key
CALENDAR_SLEEP_USER_ID=replace-with-hcgateway-user-id
CALENDAR_SLEEP_FEED_ID=e50d0983-a930-40a2-a603-3336a8aab552

# The first run covers today plus the preceding six local wake dates. Ongoing
# recent-event polling remains active, while older history is opt-in.
CALENDAR_SLEEP_INITIAL_LOOKBACK_DAYS=7
CALENDAR_SLEEP_POLL_SECONDS=300
CALENDAR_SLEEP_BACKFILL_ENABLED=false
CALENDAR_SLEEP_BACKFILL_BATCH_DAYS=7
CALENDAR_SLEEP_BACKFILL_INTERVAL_SECONDS=86400
